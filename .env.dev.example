# Copy this file to .env.dev and fill in the values locally. Never commit .env.dev.
# Validate it with cmd/deploy/dev --check, then start the stack with cmd/deploy/dev.
NGROK_DOMAIN=overfluent-rosy-soothingly.ngrok-free.dev

DATABASE_URL=steer-dev.sqlite
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELLER_APPLICATION_ID=
# This file is sourced by Bash, so command substitutions safely load local PEM files.
TELLER_CERT_PEM="$(< /absolute/path/to/teller-cert.pem)"
TELLER_KEY_PEM="$(< /absolute/path/to/teller-key.pem)"
TELLER_TOKEN_SIGNING_PUBLIC_KEY=
TOKEN_ENCRYPTION_KEY=

# Optional; cmd/deploy/dev defaults these to sandbox, 30m, and port 5173.
# TELLER_ENVIRONMENT=sandbox
# TELLER_POLL_INTERVAL=30m
# FRONTEND_PORT=5173
