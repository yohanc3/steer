# Copy this file to .env. Keep .env out of version control.
# The deployment launcher selects the Compose configuration from DEPLOYMENT_ENV.
DEPLOYMENT_ENV=dev

# PUBLIC_BASE_URL is assigned by cmd/deploy/deploy.py from the local ngrok tunnel.

# Application configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_CERT_PEM=''
TELLER_KEY_PEM=''
TELLER_TOKEN_SIGNING_PUBLIC_KEY=
TOKEN_ENCRYPTION_KEY=
TELLER_POLL_INTERVAL=30m
