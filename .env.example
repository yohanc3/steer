# Local Docker Compose ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Backend runtime configuration
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
AUTH0_AUDIENCE=http://localhost:8080/api
DATABASE_URL=/data/steer.sqlite
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Keep Telegram disabled until a public HTTPS URL or tunnel is available.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
SERVER_URL=http://localhost:8080

# These paths match the read-only ./secrets mount in compose.yaml.
TELLER_CERT_PEM=/run/secrets/steer/teller_cert.pem
TELLER_KEY_PEM=/run/secrets/steer/teller_key.pem

# Frontend values are embedded into the web image during its build.
VITE_AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_spa_client_id
VITE_AUTH0_AUDIENCE=http://localhost:8080/api
VITE_SERVER_BASE_URL=http://localhost:8080
VITE_TELLER_APP_ID=your_teller_application_id
