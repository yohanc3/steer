# Copy this file to .env. Keep .env out of version control.
# This configuration starts the development override automatically.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
DEPLOYMENT_ENV=dev

# Ngrok development endpoint.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
PUBLIC_BASE_URL=https://

# Application configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox
TELLER_CERT_PEM=''
TELLER_KEY_PEM=''
TELLER_TOKEN_SIGNING_PUBLIC_KEY=
TOKEN_ENCRYPTION_KEY=
TELLER_POLL_INTERVAL=30m
