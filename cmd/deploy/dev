#!/usr/bin/env bash
# Start a same-origin local stack, expose it through ngrok, and register the
# Telegram webhook. Configuration is read from the ignored .env.dev file.
set -Eeuo pipefail

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root_dir"

if [[ -f .env.dev ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env.dev
  set +a
fi

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'missing required command: %s\n' "$1" >&2
    exit 1
  }
}

require_value() {
  [[ -n "${!1:-}" ]] || {
    printf 'missing required environment value: %s\n' "$1" >&2
    exit 1
  }
}

for command_name in curl go ngrok npm; do
  require_command "$command_name"
done
for variable_name in DATABASE_URL NGROK_DOMAIN TELEGRAM_BOT_TOKEN TELEGRAM_WEBHOOK_SECRET TELLER_APPLICATION_ID TELLER_CERT_PEM TELLER_KEY_PEM TELLER_TOKEN_SIGNING_PUBLIC_KEY TOKEN_ENCRYPTION_KEY; do
  require_value "$variable_name"
done

export TELLER_ENVIRONMENT="${TELLER_ENVIRONMENT:-sandbox}"
export TELLER_POLL_INTERVAL="${TELLER_POLL_INTERVAL:-30m}"
export FRONTEND_PORT="${FRONTEND_PORT:-5173}"
export PUBLIC_BASE_URL="https://${NGROK_DOMAIN}"
export VITE_TELLER_APPLICATION_ID="$TELLER_APPLICATION_ID"
export VITE_TELLER_ENVIRONMENT="$TELLER_ENVIRONMENT"
export VITE_SERVER_BASE_URL=""

case "$TELLER_ENVIRONMENT" in
  sandbox|development|production) ;;
  *)
    printf 'TELLER_ENVIRONMENT must be sandbox, development, or production\n' >&2
    exit 1
    ;;
esac

if [[ "${1:-}" == "--check" ]]; then
  printf 'dev configuration valid for %s\n' "$PUBLIC_BASE_URL"
  exit 0
fi
if [[ $# -ne 0 ]]; then
  printf 'usage: %s [--check]\n' "$0" >&2
  exit 2
fi

backend_pid=""
frontend_pid=""
ngrok_pid=""
cleanup() {
  for pid in "$ngrok_pid" "$frontend_pid" "$backend_pid"; do
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT INT TERM

(cd backend && go run .) &
backend_pid="$!"
(cd frontend && npm run dev -- --host 127.0.0.1 --port "$FRONTEND_PORT" --strictPort) &
frontend_pid="$!"

for _ in {1..30}; do
  if curl --fail --silent "http://127.0.0.1:${FRONTEND_PORT}/healthz" >/dev/null; then
    break
  fi
  sleep 1
done
curl --fail --silent "http://127.0.0.1:${FRONTEND_PORT}/healthz" >/dev/null || {
  printf 'local stack did not become healthy\n' >&2
  exit 1
}

ngrok http --url="$NGROK_DOMAIN" "$FRONTEND_PORT" &
ngrok_pid="$!"

ngrok_status=""
for _ in {1..30}; do
	ngrok_status="$(curl --silent --output /dev/null --write-out '%{http_code}' "${PUBLIC_BASE_URL}/healthz" || true)"
	if [[ "$ngrok_status" == "200" ]]; then
		break
	fi
	sleep 1
done
[[ "$ngrok_status" == "200" ]] || {
	printf 'ngrok endpoint did not become healthy (HTTP %s)\n' "$ngrok_status" >&2
	exit 1
}

printf 'registering Telegram webhook: %s/telegram/webhook\n' "$PUBLIC_BASE_URL"
curl --fail --silent --show-error -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/setWebhook" \
  --data-urlencode "url=${PUBLIC_BASE_URL}/telegram/webhook" \
  --data-urlencode "secret_token=${TELEGRAM_WEBHOOK_SECRET}" \
  --data-urlencode 'allowed_updates=["message"]' >/dev/null

printf 'ready: %s\n' "$PUBLIC_BASE_URL"
printf 'send /connect to your bot; press Ctrl-C to stop the local stack.\n'
wait
