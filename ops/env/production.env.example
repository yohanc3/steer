# Compose and host paths
IMAGE_NAMESPACE=yohanc3
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=8081
STEER_DATA_DIR=/var/lib/steer
STEER_SECRETS_DIR=/opt/steer/secrets

# Backend
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.your-domain.com/api
DATABASE_URL=/data/steer.sqlite
CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# Telegram
# Keep disabled until the polling-based Telegram milestone is implemented.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
SERVER_URL=https://api.your-domain.com

# Teller certificate paths inside the backend container
TELLER_CERT_PEM=/run/secrets/steer/teller_cert.pem
TELLER_KEY_PEM=/run/secrets/steer/teller_key.pem
