# Compose and host paths; staging uses separate ports and data.
IMAGE_NAMESPACE=yohanc3
BACKEND_HOST_PORT=8180
FRONTEND_HOST_PORT=8181
STEER_DATA_DIR=/var/lib/steer-staging
STEER_SECRETS_DIR=/opt/steer-staging/secrets

# Backend
AUTH0_DOMAIN=your-auth0-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.staging.your-domain.com/api
DATABASE_URL=/data/steer.sqlite
CORS_ALLOWED_ORIGINS=https://staging.your-domain.com

# Use a separate Telegram bot for staging, or disable it.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
SERVER_URL=https://api.staging.your-domain.com

# Teller certificate paths inside the backend container
TELLER_CERT_PEM=/run/secrets/steer/teller_cert.pem
TELLER_KEY_PEM=/run/secrets/steer/teller_key.pem
